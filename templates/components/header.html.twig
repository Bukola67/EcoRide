<header class="site-header">
    <div class="container site-header__inner">

        <a class="brand" href="{{ path('app_home') }}" aria-label="EcoRide - Accueil">
            <img
                class="brand__logo"
                src="{{ asset('images/logo-ecoride.png') }}"
                alt="EcoRide, le covoiturage français écologique"
            >
        </a>

        <div class="site-header__nav-wrapper" data-controller="burger-menu">

            <button
                type="button"
                class="burger-toggle"
                data-action="click->burger-menu#toggle"
                aria-expanded="false"
                aria-label="Ouvrir le menu"
            >
                <span class="burger-toggle__bar"></span>
                <span class="burger-toggle__bar"></span>
                <span class="burger-toggle__bar"></span>
            </button>

            <div
                class="nav-panel"
                data-burger-menu-target="panel"
                data-action="click->burger-menu#close"
            >

                {# Navigation principale #}
                <nav class="site-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    <a href="{{ path('app_carpool_index') }}">Covoiturages</a>
                    <a href="{{ path('app_contact') }}">Contact</a>
                </nav>

                {# Espace employé #}
                {% if is_granted('ROLE_EMPLOYEE') %}
                    <a
                        class="site-header__link"
                        href="{{ path('app_employee_review_index') }}"
                    >
                        Avis à modérer
                    </a>

                    <a
                        class="site-header__link"
                        href="{{ path('app_employee_incident_index') }}"
                    >
                        Incidents
                    </a>
                {% endif %}

                {# Espace administrateur #}
                {% if is_granted('ROLE_ADMIN') %}
                    <a
                        class="site-header__link"
                        href="{{ path('app_admin_dashboard') }}"
                    >
                        Administration
                    </a>
                {% endif %}

                {# Espace utilisateur #}
                <nav class="site-header__nav" aria-label="Compte utilisateur">
                    {% if current_user %}
                        <a class="site-header__link" href="{{ path('app_profile') }}">
                            Mon profil
                        </a>

                        <span class="site-header__credits">
                            {{ current_user.credits }} crédits
                        </span>

                        <a class="site-header__link" href="{{ path('app_logout') }}">
                            Se déconnecter
                        </a>
                    {% else %}
                        <a class="site-header__link" href="{{ path('app_login') }}">
                            Se connecter
                        </a>

                        <a class="btn btn-primary" href="{{ path('app_register') }}">
                            S’inscrire
                        </a>
                    {% endif %}
                </nav>

            </div>

        </div>

    </div>
</header>
