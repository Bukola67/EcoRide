{% extends 'base.html.twig' %}

{% block title %}Créer un employé | EcoRide{% endblock %}

{% block body %}
    <main class="container section">
        <header class="section__header">
            <p class="eyebrow">Administration</p>

            <h1>Créer un compte employé</h1>

            <p>
                Le compte créé aura uniquement les droits employés.
            </p>
        </header>

        <section class="form-card admin-form-card">
            {{ form_start(form, {
                attr: {
                    class: 'admin-form'
                }
            }) }}

                <div class="form-group">
                    {{ form_label(form.username) }}
                    {{ form_errors(form.username) }}
                    {{ form_widget(form.username, {
                        attr: {
                            autocomplete: 'username'
                        }
                    }) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_errors(form.email) }}
                    {{ form_widget(form.email, {
                        attr: {
                            autocomplete: 'email'
                        }
                    }) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.plainPassword) }}
                    {{ form_errors(form.plainPassword) }}
                    {{ form_widget(form.plainPassword) }}

                    <small class="form-help">
                        Au moins 12 caractères. L’employé pourra changer ce mot de passe ultérieurement.
                    </small>
                </div>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">
                        Créer le compte employé
                    </button>

                    <a
                        class="btn btn-outline"
                        href="{{ path('app_admin_dashboard') }}"
                    >
                        Annuler
                    </a>
                </div>

            {{ form_end(form) }}
        </section>
    </main>
{% endblock %}