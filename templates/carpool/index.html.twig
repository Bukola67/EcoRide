{% extends 'base.html.twig' %}

{% block title %}Covoiturages | EcoRide{% endblock %}

{% block body %}
    <main class="container">
        <section class="hero">
            <div class="hero__content">
                <h1>Trouvez votre covoiturage</h1>
                <p>Indiquez votre ville de départ, votre destination et votre date de voyage.</p>
            </div>
        </section>

        <section class="search-panel" aria-labelledby="search-title">
            <h2 id="search-title">Rechercher un trajet</h2>

            <form class="search-form" method="get" action="{{ path('app_carpool_index') }}">
                <div class="form-group">
                    <label for="departure">Ville de départ</label>
                    <input id="departure" name="departure" type="text" required>
                </div>

                <div class="form-group">
                    <label for="arrival">Ville d’arrivée</label>
                    <input id="arrival" name="arrival" type="text" required>
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input id="date" name="date" type="date" required>
                </div>

                <button class="btn btn-primary" type="submit">
                    Rechercher
                </button>
            </form>
        </section>

        <section class="container" style="padding: 2rem 0;">
            <p>Aucun covoiturage n’est affiché avant une recherche.</p>
        </section>
    </main>
{% endblock %}