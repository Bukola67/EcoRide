{% extends 'base.html.twig' %}

{% block title %}EcoRide | Le covoiturage français écologique{% endblock %}

{% block body %}
    <section class="hero hero--home">
        <div class="container hero__grid">
            <div class="hero__content">
                <p class="eyebrow">
                    <span aria-hidden="true"></span>
                    Le covoiturage français écologique
                </p>

                <h1>Voyagez ensemble,<br>roulez plus responsable.</h1>

                <p class="lead">
                    EcoRide vous aide à trouver un trajet près de chez vous,
                    à partager les frais et à réduire l’impact de chaque déplacement.
                </p>

                <div class="hero__actions">
                    <a class="btn btn-primary" href="#search">
                        Trouver un trajet
                    </a>

                    <a class="btn btn-outline" href="#how-it-works">
                        Découvrir EcoRide
                    </a>
                </div>
            </div>

            <div class="hero__media">
                <img
                    src="{{ asset('images/hero-ecoride.jpg') }}"
                    alt="Une voiture roule sur une route bordée de nature"
                >
                <div class="hero__eco-card">
                    <span class="hero__eco-icon" aria-hidden="true"></span>
                    <div>
                        <strong>Moins de trajets seuls</strong>
                        <span>Plus de mobilité partagée</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="search" class="search-section">
        <div class="container">
            <div class="search-panel search-panel--floating">
                <div class="search-panel__heading">
                    <p class="eyebrow">Votre prochain trajet</p>
                    <h2>Où souhaitez-vous aller ?</h2>
                </div>

                <form
                    class="search-form"
                    method="get"
                    action="{{ path('app_carpool_index') }}"
                >
                    <div class="form-group">
                        <label for="departure">Ville de départ</label>
                        <input
                            id="departure"
                            name="departure"
                            type="text"
                            placeholder="Ex. Paris"
                            autocomplete="address-level2"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="arrival">Ville d’arrivée</label>
                        <input
                            id="arrival"
                            name="arrival"
                            type="text"
                            placeholder="Ex. Lyon"
                            autocomplete="address-level2"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="date">Date de départ</label>
                        <input
                            id="date"
                            name="date"
                            type="date"
                            min="{{ minDate }}"
                            required
                        >
                    </div>

                    <button class="btn btn-primary search-form__submit" type="submit">
                        Rechercher
                    </button>
                </form>
            </div>
        </div>
    </section>

    <section id="how-it-works" class="section">
        <div class="container">
            <header class="section__header">
                <p class="eyebrow">Simple et responsable</p>
                <h2>Le covoiturage, plus simplement</h2>
                <p>
                    EcoRide met en relation des voyageurs pour rendre chaque
                    déplacement plus économique, convivial et respectueux de l’environnement.
                </p>
            </header>

            <div class="benefits-grid">
                <article class="benefit-card">
                    
                    <h3>Recherchez</h3>
                    <p>Indiquez votre ville de départ, votre destination et votre date de voyage.</p>
                </article>

                <article class="benefit-card">
                    
                    <h3>Choisissez</h3>
                    <p>Comparez les horaires, le prix, les places disponibles et les informations du chauffeur.</p>
                </article>

                <article class="benefit-card">
                    <h3>Partagez</h3>
                    <p>Voyagez à plusieurs et privilégiez les trajets effectués en véhicule électrique.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="section section--light">
        <div class="container commitment">
            <div class="commitment__content">
                <p class="eyebrow">Notre engagement</p>
                <h2>Chaque place partagée compte.</h2>
                <p class="lead">
                    En favorisant le covoiturage et les véhicules électriques,
                    EcoRide contribue à des déplacements plus sobres au quotidien.
                </p>
            </div>

            <a class="btn btn-secondary" href="{{ path('app_carpool_index') }}">
                Voir les covoiturages
            </a>
        </div>
    </section>
{% endblock %}